---
import Layout from '../layouts/Layout.astro';
import VirtualOfficeShell from '@/components/portfolio/VirtualOfficeShell';
import { PORTFOLIO_PROJECTS, ROOMS, CONTACT_INFO } from '@/lib/portfolio-data';

const homeJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${CONTACT_INFO.websiteUrl}/#person`,
      name: CONTACT_INFO.fullName,
      jobTitle: CONTACT_INFO.title,
      description: CONTACT_INFO.summary,
      email: CONTACT_INFO.email,
      url: CONTACT_INFO.websiteUrl,
      sameAs: [CONTACT_INFO.linkedinUrl, CONTACT_INFO.websiteUrl]
    },
    {
      '@type': 'WebSite',
      '@id': `${CONTACT_INFO.websiteUrl}/#website`,
      url: CONTACT_INFO.websiteUrl,
      name: 'Rizal OS — 3D Virtual Office Portfolio',
      description: 'Interactive 3D Virtual Office and technical portfolio for Rizal Hanifa Pratama: Coding Teacher, IT Project Manager, and Digitalization Specialist.',
      publisher: {
        '@id': `${CONTACT_INFO.websiteUrl}/#person`
      }
    },
    {
      '@type': 'ItemList',
      name: 'Verified Case Studies & Software Systems',
      itemListElement: PORTFOLIO_PROJECTS.map((project, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: project.title,
        description: project.summary,
        url: `https://www.riizalhp.web.id/cases/${project.slug}`
      }))
    }
  ]
};
---

<Layout
  title="Rizal OS — 3D Virtual Office & Portfolio | Rizal Hanifa Pratama"
  description="Interactive 3D Spatial Virtual Office & Portfolio by Rizal Hanifa Pratama — Coding Teacher @ SMA IHSANUL FIKRI MUNGKID & IT Project Manager."
  jsonLd={homeJsonLd}
>
  <!-- Interactive 3D Virtual Office Client Island -->
  <main class="relative w-screen h-screen overflow-hidden bg-[#121314]">
    <VirtualOfficeShell client:only="react" initialRoom="lobby">
      <!-- Instant SSR Fallback: Sapaan langsung muncul tanpa layar hitam sambil menunggu React & 3D di latar belakang -->
      <div
        slot="fallback"
        role="dialog"
        aria-modal="true"
        aria-label="Visual Novel Greeting by Rizal"
        class="fixed inset-0 z-50 flex flex-col justify-end pointer-events-auto select-none bg-black/65 backdrop-blur-xs"
      >
        <div class="relative w-full max-w-5xl mx-auto px-3 sm:px-6 pb-2 sm:pb-8 [@media(max-height:550px)]:pb-2 flex flex-col md:flex-row items-end gap-0 md:gap-6">
          <!-- Character Sprite Container -->
          <div class="relative z-10 shrink-0 self-center md:self-end -mb-3 sm:-mb-6 md:-mb-8 pointer-events-none select-none">
            <div class="absolute inset-0 bg-[#f5d400]/10 blur-3xl rounded-full transform scale-90"></div>
            <div class="relative w-36 sm:w-52 md:w-80 lg:w-92 h-44 sm:h-64 md:h-96 [@media(max-height:550px)]:w-36 [@media(max-height:550px)]:h-44">
              <img
                src="/avatar/rizal-wave.webp"
                alt="Rizal — Tukang Manage Produk"
                class="w-full h-full object-contain filter drop-shadow-[0_20px_25px_rgba(0,0,0,0.85)]"
                loading="eager"
                decoding="sync"
              />
            </div>
          </div>

          <!-- VN Dialogue Box -->
          <div class="relative z-20 w-full flex-1">
            <div class="group relative p-3.5 sm:p-5 md:p-6 [@media(max-height:550px)]:p-3 rounded-2xl bg-[#121314]/94 border border-[rgba(255,255,255,0.12)] shadow-2xl backdrop-blur-xl">
              <!-- Nameplate Badge -->
              <div class="absolute -top-3.5 left-5 flex items-center gap-2 px-3.5 py-1 rounded-lg bg-[#18191b] border border-[rgba(255,255,255,0.15)] shadow-md">
                <span class="w-2 h-2 rounded-full bg-[#f5d400] animate-pulse"></span>
                <span class="font-display text-xs sm:text-sm font-bold tracking-tight text-[#f5d400]">
                  Rizal
                </span>
                <span class="text-[10px] font-mono text-[#77787c] hidden sm:inline">
                  • Coding Teacher &amp; IT Project Manager
                </span>
              </div>

              <!-- Dialogue Text -->
              <div class="min-h-[64px] sm:min-h-[72px] flex items-center pt-1">
                <p class="font-sans text-sm sm:text-base md:text-lg text-[#e8e8e9] leading-relaxed tracking-[-0.01em]">
                  Halo, saya Rizal Hanifa Pratama.
                  <span class="inline-block w-2 h-4 ml-1 bg-[#f5d400] vn-cursor-blink align-middle"></span>
                </p>
              </div>

              <!-- Bottom Indicator -->
              <div class="mt-3 pt-2.5 border-t border-[rgba(255,255,255,0.06)] flex items-center justify-between text-xs font-mono text-[#77787c]">
                <div class="flex items-center gap-2">
                  <span>1 / 3</span>
                  <span class="hidden sm:inline text-[#505156]">·</span>
                  <span class="hidden sm:inline text-[11px] text-[#a7a7aa]">
                    Menyiapkan kantor virtual di latar belakang...
                  </span>
                </div>

                <div class="flex items-center gap-1.5 text-[#f5d400] font-medium">
                  <span class="text-[11px] hidden sm:inline">Lanjut</span>
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                  </svg>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </VirtualOfficeShell>
  </main>

  <!-- Semantic SEO Layer for Search Engines, Screen Readers, & Quick Indexing -->
  <section class="sr-only" aria-label="Portofolio Lengkap Rizal Hanifa Pratama">
    <h1>Rizal Hanifa Pratama — Coding Teacher &amp; IT Project Manager</h1>
    <p>
      Coding Teacher di SMA IHSANUL FIKRI MUNGKID &amp; IT Project Manager dengan latar belakang S1 Informatika UPN Veteran Yogyakarta. Berpengalaman dalam pengajaran bilingual (ICIF), penjaminan mutu akademik SPMI, operasional lab komputer 50+ unit, dan manajemen proyek perangkat lunak.
    </p>

    <h2>Ruangan Kerja 3D Virtual Office</h2>
    <ul>
      {ROOMS.map((r) => (
        <li>
          <a href={`/?room=${r.id}`}>{r.name} ({r.roleLabel})</a>: {r.description}
        </li>
      ))}
    </ul>

    <h2>Daftar Studi Kasus & Proyek Unggulan</h2>
    <ul>
      {PORTFOLIO_PROJECTS.map((p) => (
        <li>
          <article>
            <h3><a href={`/cases/${p.slug}`}>{p.title}</a></h3>
            <p><strong>Peran:</strong> {p.role} | <strong>Status:</strong> {p.projectStatus} | <strong>Periode:</strong> {p.period}</p>
            <p>{p.summary}</p>
            <p><strong>Masalah:</strong> {p.problem}</p>
            <p><strong>Hasil / Dampak:</strong> {p.outcomes.join(', ')}</p>
            <a href={`/projects/${p.slug}`}>Lihat detail proyek {p.title}</a>
          </article>
        </li>
      ))}
    </ul>

    <h2>Navigasi Halaman Portofolio</h2>
    <nav>
      <a href="/cases">Daftar Semua Studi Kasus</a>
      <a href="/projects">Daftar Semua Proyek</a>
      <a href="/systems">Laboratorium Sistem & Metodologi</a>
      <a href="/experience">Riwayat Pengalaman Kerja</a>
      <a href="/api/cv">Unduh CV Rizal (Format Text)</a>
    </nav>
  </section>
</Layout>
