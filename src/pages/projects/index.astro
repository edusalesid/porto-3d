---
import Layout from '../../layouts/Layout.astro';
import StaticNav from '../../components/StaticNav.astro';
import StaticFooter from '../../components/StaticFooter.astro';
import { PORTFOLIO_PROJECTS } from '@/lib/portfolio-data';

const title = 'Direktori Proyek & Sistem Perangkat Lunak | Rizal';
const description = 'Showcase portofolio produk dan sistem perangkat lunak yang dirancang dan dieksekusi oleh Rizal — Technical Project Manager.';
---

<Layout title={title} description={description}>
  <StaticNav />

  <main class="max-w-6xl mx-auto px-4 sm:px-6 py-12 md:py-20">
    <!-- Header -->
    <div class="mb-12 max-w-3xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#18191b] border border-[rgba(255,255,255,0.08)] text-xs font-mono text-[#38bdf8] mb-4">
        <span class="w-2 h-2 rounded-full bg-[#38bdf8] animate-pulse"></span>
        <span>Projects Command Center</span>
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-display font-bold tracking-tight text-[#e8e8e9] mb-4">
        Proyek & Portofolio Sistem
      </h1>
      <p class="text-base sm:text-lg text-[#a7a7aa] leading-relaxed">
        Koleksi produk digital, platform SaaS, otomasi operasional, dan arsitektur workflow yang telah berhasil di-deploy ke lingkungan produksi.
      </p>
    </div>

    <!-- Projects Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {PORTFOLIO_PROJECTS.map((project) => (
        <div class="flex flex-col justify-between p-6 rounded-2xl bg-[#18191b] border border-[rgba(255,255,255,0.08)] hover:border-[rgba(255,255,255,0.18)] transition-all group">
          <div>
            <!-- Banner thumbnail -->
            {project.bannerImage ? (
              <div class="h-44 -mx-6 -mt-6 mb-5 overflow-hidden rounded-t-2xl bg-[#141516] border-b border-[rgba(255,255,255,0.06)]">
                <img
                  src={project.bannerImage}
                  alt={project.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                />
              </div>
            ) : (
              <div class="h-28 -mx-6 -mt-6 mb-5 bg-linear-to-br from-[#1d1e20] to-[#141516] rounded-t-2xl border-b border-[rgba(255,255,255,0.06)] flex items-center justify-center">
                <span class="font-mono text-xs text-[#77787c]">Project #{project.relevanceRank}</span>
              </div>
            )}

            <!-- Categories -->
            <div class="flex flex-wrap items-center gap-1.5 mb-3">
              {project.category.map((cat) => (
                <span class="text-[11px] font-mono px-2 py-0.5 rounded-md bg-[#232426] text-[#a7a7aa]">
                  {cat}
                </span>
              ))}
            </div>

            <!-- Title -->
            <h2 class="text-lg font-display font-semibold text-[#e8e8e9] group-hover:text-white mb-2 leading-snug">
              <a href={`/projects/${project.slug}`} class="hover:underline">
                {project.title}
              </a>
            </h2>

            <!-- Role & status -->
            <div class="text-xs font-mono text-[#77787c] mb-3">
              <span>{project.role}</span> • <span class="text-[#46c98a]">{project.projectStatus}</span>
            </div>

            <p class="text-xs text-[#a7a7aa] leading-relaxed line-clamp-3 mb-4">
              {project.summary}
            </p>
          </div>

          <!-- Bottom links -->
          <div class="pt-4 border-t border-[rgba(255,255,255,0.06)] flex items-center justify-between text-xs font-medium">
            <a href={`/cases/${project.slug}`} class="text-[#f5d400] hover:underline font-semibold">
              Studi Kasus →
            </a>

            <a
              href={`/?case=${project.slug}`}
              class="px-2.5 py-1 rounded-md bg-[#1d1e20] text-[#38bdf8] hover:bg-[#28292b] border border-[rgba(255,255,255,0.08)]"
            >
              Lihat di 3D
            </a>
          </div>
        </div>
      ))}
    </div>
  </main>

  <StaticFooter />
</Layout>
